# URL del proxy-server (sin trailing slash)
VITE_PROXY_URL=http://localhost:3001

# Modo de la app:
#   office → versión de escritorio (crear cuadrantes, descargar ZIP)
#   field  → versión de terreno (seleccionar cuadrante, subir fotos)
VITE_APP_MODE=office

# Fase del módulo de anotación:
#   1 = pasivo (extrae EXIF, imagen sin modificar) — DEFAULT
#   2 = activo (overlay GPS + timestamp via Canvas API)
VITE_ANNOTATION_PHASE=1

# Backend Supabase
VITE_SUPABASE_URL=https://xwawplezarrfonuyaaxu.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Modo invitado (cuenta compartida temporal, rol jp). Crear el usuario en
# Supabase (Auth → Add user, Auto Confirm) y ponerle rol='jp'. Si se dejan
# vacías, el botón "Continuar como invitado" no aparece.
# OJO: estas credenciales quedan embebidas en el bundle → no desplegar público.
VITE_GUEST_EMAIL=
VITE_GUEST_PASSWORD=
